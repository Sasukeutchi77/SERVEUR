# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# BOTCLOUD PAAS CONFIGURATION
# ==============================================================================

# Node Environment & Port (Default 3000 for AI Studio / Container proxy)
NODE_ENV="development"
PORT="3000"

# Database Configuration (PostgreSQL chosen for strict ACID, relational integrity, JSONB support)
DATABASE_URL="postgresql://botcloud_user:botcloud_secure_password@localhost:5432/botcloud_db?schema=public"

# Redis Queue & Caching (BullMQ / Job Queue / Real-time PubSub)
REDIS_URL="redis://:botcloud_redis_secret@localhost:6379/0"

# Authentication & Security Secrets
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-random-64-char-secret-key-for-jwt"
JWT_EXPIRES_IN="7d"

# AES-256-GCM Encryption key for environment variables (32 bytes hex or base64)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Storage & Persistence Paths
WORKSPACE_STORAGE_PATH="./data/workspaces"
PERSISTENT_VOLUMES_PATH="./data/volumes"
LOGS_STORAGE_PATH="./data/logs"

# Docker Engine & Worker Settings
DOCKER_SOCKET_PATH="/var/run/docker.sock"
DOCKER_NETWORK_NAME="botcloud_isolated_net"
DOCKER_DEFAULT_CPU_LIMIT="0.5"
DOCKER_DEFAULT_MEMORY_LIMIT="512m"
DOCKER_DEFAULT_DISK_LIMIT="2g"

# Max limits per deployment
MAX_ZIP_SIZE_MB="50"
MAX_LOG_HISTORY_LINES="2000"

